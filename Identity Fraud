local function enableSmoothDrag(frame, clickCallback, isLockedFunc)
    local dragging = false
    local dragInput, dragStart, startPos
    local hasMoved = false

    frame.InputBegan:Connect(function(input)
        if isLockedFunc and isLockedFunc() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = frame.Position

            local con
            con = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if con then con:Disconnect() end
                    if not hasMoved and clickCallback then
                        clickCallback()
                    end
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if isLockedFunc and isLockedFunc() then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isLockedFunc and isLockedFunc() then
            dragging = false
            return
        end
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                hasMoved = true
            end
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function applyErrorButtonDesign(btn, hoverColor)
    btn.BackgroundColor3 = C_ERROR_BG
    btn.ClipsDescendants = true

    if not btn:FindFirstChildOfClass("UICorner") then
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    end

    local errorOverlay = btn:FindFirstChild("ErrorPatternOverlay")
    if not errorOverlay then
        errorOverlay = Instance.new("ImageLabel")
        errorOverlay.Name = "ErrorPatternOverlay"
        errorOverlay.Size = UDim2.new(1, 0, 1, 0)
        errorOverlay.Position = UDim2.new(0, 0, 0, 0)
        errorOverlay.BackgroundTransparency = 1
        errorOverlay.Image = "rbxassetid://2151741365"
        errorOverlay.ImageColor3 = C_RED
        errorOverlay.ImageTransparency = 0.8
        errorOverlay.ScaleType = Enum.ScaleType.Tile
        errorOverlay.TileSize = UDim2.new(0, 16, 0, 16)
        errorOverlay.ZIndex = btn.ZIndex
        errorOverlay.Parent = btn
    end

    local origSize = btn.Size
    local origColor = btn.BackgroundColor3
    hoverColor = hoverColor or Color3.fromRGB(55, 12, 20)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor
        }):Play()
        if errorOverlay then
            TweenService:Create(errorOverlay, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {ImageTransparency = 0.65}):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = origColor,
            Size = origSize
        }):Play()
        if errorOverlay then
            TweenService:Create(errorOverlay, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {ImageTransparency = 0.8}):Play()
        end
    end)
end

