-- 15. MONSTER & PLAYER ESP
-- =========================================================================
local playerEspEnabled = false
local npcEspEnabled = false
local playerEspHolder = {}
local npcEspHolder = {}

local targetNpcNames = {"fraud", "kate", "ralph", "hurdle", "stan", "james"}

local function isMuseumEntity(model)
    local current = model
    while current and current ~= workspace do
        local cName = string.lower(current.Name)
        if string.find(cName, "museum") or string.find(cName, "statue") or string.find(cName, "showcase") or string.find(cName, "display") then
            return true
        end
        current = current.Parent
    end

    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart
    if root and root:IsA("BasePart") and root.Anchored then
        return true
    end

    return false
end

local function isTargetNpc(model)
    if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then return false end
    if isMuseumEntity(model) then return false end

    local nameLower = string.lower(model.Name)
    for _, npcName in ipairs(targetNpcNames) do
        if string.find(nameLower, npcName) then return true end
    end
    return false
end

local function removeEspFromModel(model, cacheTable)
    if cacheTable[model] then
        if cacheTable[model].hl then cacheTable[model].hl:Destroy() end
        if cacheTable[model].bb then cacheTable[model].bb:Destroy() end
        cacheTable[model] = nil
    end
end

local function applyEspToModel(model, isNpc, cacheTable)
    if cacheTable[model] then return end
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not head then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillColor = isNpc and Color3.fromRGB(255, 30, 60) or Color3.fromRGB(0, 255, 180)
    hl.FillTransparency = isNpc and 0.65 or 0.70
    hl.OutlineColor = isNpc and Color3.fromRGB(255, 90, 110) or Color3.fromRGB(0, 255, 230)
    hl.OutlineTransparency = isNpc and 0.3 or 0.4
    hl.Parent = screenGui

    local bb = Instance.new("BillboardGui")
    bb.Adornee = head
    bb.Size = UDim2.new(0, 140, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = screenGui

    local txt = Instance.new("TextLabel", bb)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextTransparency = 0.15
    txt.TextColor3 = isNpc and Color3.fromRGB(255, 80, 100) or Color3.fromRGB(0, 255, 200)
    txt.Font = Enum.Font.Code
    txt.TextSize = 10
    txt.Text = model.Name

    cacheTable[model] = {hl = hl, bb = bb, txt = txt, head = head}
end

local function clearEspCache(cacheTable)
    for _, data in pairs(cacheTable) do
        if data.hl then data.hl:Destroy() end
        if data.bb then data.bb:Destroy() end
    end
    table.clear(cacheTable)
end

local function registerNpc(obj)
    if isTargetNpc(obj) and npcEspEnabled then
        applyEspToModel(obj, true, npcEspHolder)
    end
end

task.spawn(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isTargetNpc(obj) then
            if npcEspEnabled then
                applyEspToModel(obj, true, npcEspHolder)
            end
        end
    end
end)

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        task.wait(0.1)
        registerNpc(obj)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if npcEspHolder[obj] then
        removeEspFromModel(obj, npcEspHolder)
    end
end)

local espUpdateInterval = 0
RunService.Heartbeat:Connect(function(dt)
    espUpdateInterval = espUpdateInterval + dt
    if espUpdateInterval < 0.05 then return end
    espUpdateInterval = 0

    local myChar = LocalPlayer.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

    if playerEspEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                if not playerEspHolder[plr.Character] then
                    applyEspToModel(plr.Character, false, playerEspHolder)
                end
            end
        end

        for model, data in pairs(playerEspHolder) do
            if not model or not model.Parent or not model:FindFirstChild("HumanoidRootPart") then
                removeEspFromModel(model, playerEspHolder)
            else
                if myHrp and data.txt and model:FindFirstChild("HumanoidRootPart") then
                    local dist = math.floor((myHrp.Position - model.HumanoidRootPart.Position).Magnitude)
                    data.txt.Text = "👤 " .. model.Name .. " [" .. dist .. "m]"
                end
            end
        end
    end

    if npcEspEnabled then
        for model, data in pairs(npcEspHolder) do
            if not model or not model.Parent or isMuseumEntity(model) then
                removeEspFromModel(model, npcEspHolder)
            else
                local targetPos = data.head and data.head.Position
                if myHrp and targetPos and data.txt then
                    local dist = math.floor((myHrp.Position - targetPos).Magnitude)
                    data.txt.Text = "👾 " .. model.Name:upper() .. " [" .. dist .. "m]"
                end
            end
        end
    end
end)

btnPlayerEsp.MouseButton1Click:Connect(function()
    playKeyClickSound()
    playerEspEnabled = not playerEspEnabled
    if not playerEspEnabled then
        clearEspCache(playerEspHolder)
    end
    btnPlayerEsp.Text = playerEspEnabled and "👁️ PLAYER RADAR: [ACTIVE]" or "👁️ PLAYER RADAR: [OFF]"
    btnPlayerEsp.TextColor3 = playerEspEnabled and C_CYAN or C_NEON
end)

btnNpcEsp.MouseButton1Click:Connect(function()
    playKeyClickSound()
    npcEspEnabled = not npcEspEnabled
    if npcEspEnabled then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and isTargetNpc(obj) then
                applyEspToModel(obj, true, npcEspHolder)
            end
        end
    else
        clearEspCache(npcEspHolder)
    end
    btnNpcEsp.Text = npcEspEnabled and "👾 MONSTER ESP: [ACTIVE]" or "👾 MONSTER ESP: [OFF]"
    btnNpcEsp.TextColor3 = npcEspEnabled and C_RED or C_NEON
end)
