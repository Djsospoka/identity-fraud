local playerEspHolder = {}
local npcEspHolder = {}

local targetNpcNames = {"fraud", "kate", "ralph", "hurdle", "stan", "james"}

local function isTargetNpc(model)
    if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then return false end
    local nameLower = string.lower(model.Name)
    for _, npcName in ipairs(targetNpcNames) do
        if string.find(nameLower, npcName) then return true end
    end
    return false
end

local function applyEspToModel(model, isNpc, cacheTable)
    if cacheTable[model] then return end
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not head then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = model
    if isNpc then
        hl.FillColor = Color3.fromRGB(255, 30, 60)
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.fromRGB(255, 90, 110)
        hl.OutlineTransparency = 0.3
    else
        hl.FillColor = Color3.fromRGB(0, 255, 180)
        hl.FillTransparency = 0.70
        hl.OutlineColor = Color3.fromRGB(0, 255, 230)
        hl.OutlineTransparency = 0.4
    end
    hl.Parent = screenGui

    local bb = Instance.new("BillboardGui")
    bb.Adornee = head
    bb.Size = UDim2.new(0, 140, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = screenGui

    local txt = Instance.new("TextLabel", bb)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextTransparency = 0.15
    txt.TextColor3 = isNpc and Color3.fromRGB(255, 100, 120) or Color3.fromRGB(0, 255, 200)
    txt.Font = Enum.Font.Code
    txt.TextSize = 10
    txt.Text = model.Name

    cacheTable[model] = {hl = hl, bb = bb, txt = txt}
end

local function clearEspCache(cacheTable)
    for _, data in pairs(cacheTable) do
        if data.hl then data.hl:Destroy() end
        if data.bb then data.bb:Destroy() end
    end
    table.clear(cacheTable)
end

local espTimer = 0
RunService.Heartbeat:Connect(function(dt)
    espTimer = espTimer + dt
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if espTimer >= 0.5 then
        espTimer = 0

        if playerEspEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    applyEspToModel(plr.Character, false, playerEspHolder)
                end
            end
        end

        if npcEspEnabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isTargetNpc(obj) then
                    applyEspToModel(obj, true, npcEspHolder)
                end
            end
        end
    end

    for model, data in pairs(playerEspHolder) do
        if not playerEspEnabled or not model or not model.Parent or not model:FindFirstChild("HumanoidRootPart") then
            if data.hl then data.hl:Destroy() end
            if data.bb then data.bb:Destroy() end
            playerEspHolder[model] = nil
        else
            if myHrp and data.txt then
                local dist = math.floor((myHrp.Position - model.HumanoidRootPart.Position).Magnitude)
                data.txt.Text = "👤 " .. model.Name .. " [" .. dist .. "m]"
            end
        end
    end

    for model, data in pairs(npcEspHolder) do
        if not npcEspEnabled or not model or not model.Parent then
            if data.hl then data.hl:Destroy() end
            if data.bb then data.bb:Destroy() end
            npcEspHolder[model] = nil
        else
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
            if myHrp and hrp and data.txt then
                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                data.txt.Text = "👾 " .. model.Name .. " [" .. dist .. "m]"
            end
        end
    end
end)

btnPlayerEsp.MouseButton1Click:Connect(function()
    playerEspEnabled = not playerEspEnabled
    if not playerEspEnabled then clearEspCache(playerEspHolder) end
    btnPlayerEsp.Text = playerEspEnabled and "👁️ PLAYER RADAR: [ACTIVE]" or "👁️ PLAYER RADAR: [OFF]"
    btnPlayerEsp.TextColor3 = playerEspEnabled and C_CYAN or C_NEON
end)

btnNpcEsp.MouseButton1Click:Connect(function()
    npcEspEnabled = not npcEspEnabled
    if not npcEspEnabled then clearEspCache(npcEspHolder) end
    btnNpcEsp.Text = npcEspEnabled and "👾 ENTITY ESP: [ACTIVE]" or "👾 ENTITY ESP: [OFF]"
    btnNpcEsp.TextColor3 = npcEspEnabled and C_RED or C_NEON
end)
