local function applyBinaryBackground(btn)
    btn.ClipsDescendants = true
    local bgFrame = Instance.new("Frame", btn)
    bgFrame.Size = UDim2.new(1, 0, 1, 0)
    bgFrame.BackgroundTransparency = 1
    bgFrame.ZIndex = 1

    local label = Instance.new("TextLabel", bgFrame)
    label.Size = UDim2.new(1, 0, 2, 0)
    label.Position = UDim2.new(0, 0, -1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = C_NEON
    label.TextTransparency = 0.9
    label.TextSize = 8
    label.Font = Enum.Font.Code
    label.TextWrapped = true
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Text = "01001000 01000001 01000011 01001011\n11001101 00110010 10101010 01010101\n00101011 11010100 11110000 00001111"
    label.ZIndex = 1

    task.spawn(function()
        while btn and btn.Parent do
            label.Position = UDim2.new(0, 0, -1, 0)
            local tween = TweenService:Create(label, TweenInfo.new(3.5, Enum.EasingStyle.Linear), {Position = UDim2.new(0, 0, 0, 0)})
            tween:Play()
            tween.Completed:Wait()
        end
    end)
end

local function attachBtnAnim(btn, hoverColor)
    applyBinaryBackground(btn)
    local origSize = btn.Size
    local origColor = btn.BackgroundColor3
    hoverColor = hoverColor or Color3.fromRGB(math.min(origColor.R * 255 + 30, 255), math.min(origColor.G * 255 + 30, 255), math.min(origColor.B * 255 + 30, 255))

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor
        }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = origColor,
            Size = origSize
        }):Play()
    end)

    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(origSize.X.Scale * 0.95, origSize.X.Offset * 0.95, origSize.Y.Scale * 0.95, origSize.Y.Offset * 0.95)
        }):Play()
    end)

    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = origSize
        }):Play()
    end)
end

